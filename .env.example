# Local Docker: http://localhost:3000/pmcanvas/
PUBLIC_ORIGIN=http://localhost:3000
BASE_PATH=/pmcanvas
APP_PORT=3000
APP_DATABASE=pmcanvas
# Optional: enable config-based OIDC / SAML / AD LDAPS connections.
# Docker path (native Node: use an absolute or project-relative file path).
AUTH_CONFIG_FILE=
# Optional private CA for OIDC HTTPS. Never disable TLS verification.
NODE_EXTRA_CA_CERTS=

# Set three DIFFERENT passwords; all must be filled before docker compose up.
DB_ADMIN_PASSWORD=
DB_PASSWORD=
ADMIN_EMAIL=
ADMIN_NAME=관리자
ADMIN_PASSWORD=

# Used ONLY by compose.external.yml or native Node execution.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=pmcanvas
PGUSER=pmcanvas
PGPASSWORD=
PGSSLMODE=verify-full
# For a private CA in the external DB container:
# PGSSLROOTCERT=/app/certs/root-ca.crt
PGSSLROOTCERT=

# Required for administrator MFA. Generated by npm run setup / service:up.
MFA_KEY_FILE=/app/config/secrets/mfa.key
# Exact immediate proxy IPs, comma-separated. Proxy must OVERWRITE X-Forwarded-For.
TRUSTED_PROXIES=

# Self-registration requires administrator approval. Set disabled for SSO-only use.
REGISTRATION_MODE=approval
# Optional exact company email domains (comma-separated); approval still required.
REGISTRATION_DOMAINS=

# Optional SMTP configuration. Default: config/mail.json when present.
# Docker example: /app/config/mail.json
MAIL_CONFIG_FILE=
