{
  "name": "pmcanvas-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline PM Canvas for iPhone and Android",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "prepare:icons": "node scripts/prepare-icons.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "android:apk": "npm run sync && node scripts/build-android.mjs",
    "ios": "npm run sync && cap open ios",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "test:android": "node test/android-smoke.mjs",
    "test:ios": "node scripts/verify-ios.mjs",
    "dist:ios": "node scripts/build-ios-store.mjs",
    "upload:ios": "node scripts/upload-ios-store.mjs",
    "screenshots:ios": "node scripts/ios-store-screenshots.mjs",
    "format:check": "prettier --check src test scripts docs *.json *.mjs index.html README.md"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.0",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@playwright/test": "1.64.1",
    "fake-indexeddb": "6.2.5",
    "plist": "3.1.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "xcode": "4.0.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.3"
  }
}
