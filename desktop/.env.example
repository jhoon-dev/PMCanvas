# Copy to .env.signing (ignored). Put certificates outside the repository.
# Windows: .pfx file path or base64 certificate.
WIN_CSC_LINK=
WIN_CSC_KEY_PASSWORD=
# Alternative: hardware-backed certificate in the Windows certificate store.
WIN_CSC_SHA1=
# macOS: Developer ID Application certificate (.p12 path or base64).
CSC_LINK=
CSC_KEY_PASSWORD=
# Notarization: use this complete API-key group, or the Apple ID group below.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
# Alternative: an existing notarytool keychain profile.
APPLE_KEYCHAIN=
APPLE_KEYCHAIN_PROFILE=
