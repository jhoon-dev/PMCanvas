{
  "name": "pmcanvas-desktop",
  "version": "1.9.1",
  "private": true,
  "description": "Offline project planning for Windows and macOS",
  "author": "jhoon-dev",
  "productName": "PM Canvas",
  "type": "module",
  "main": "main.mjs",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "prepare:icons": "node scripts/prepare-icons.cjs",
    "signing:setup": "node scripts/setup-mac-signing.mjs",
    "start": "npm run prepare:app && electron .",
    "test": "node --test test/*.test.mjs",
    "test:app": "node test/app-smoke.mjs && node test/tabs-smoke.mjs && node test/holiday-sync-smoke.mjs",
    "pack": "npm run prepare:app && electron-builder --dir",
    "dist:win": "node --env-file-if-exists=.env.msix scripts/store.mjs",
    "dist:win:dev": "npm run prepare:app && electron-builder --win nsis --x64 --config.win.signAndEditExecutable=false",
    "dist:mac": "node --env-file-if-exists=.env.signing scripts/release.mjs mac",
    "dist:mas": "node --env-file-if-exists=.env.mas scripts/mac-store.mjs",
    "verify:mas": "node scripts/mac-store.mjs --verify",
    "release:check:mas": "node --env-file-if-exists=.env.mas scripts/mac-store.mjs --check",
    "pretest": "npm run prepare:app",
    "pretest:app": "npm run prepare:app",
    "pretest:renderer": "npm run prepare:app",
    "test:renderer": "node test/renderer-smoke.mjs && node test/update-renderer-smoke.mjs && node test/ui-layout.mjs && node test/ux-flows.mjs && node test/holiday-picker-flow.mjs",
    "release:check:win": "node --env-file-if-exists=.env.msix scripts/store.mjs --check",
    "release:check:mac": "node --env-file-if-exists=.env.signing scripts/release.mjs mac --check",
    "test:dates-language": "node --test test/date-language-smoke.mjs",
    "test:package": "node test/package-safety.mjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "korean-lunar-calendar": "0.4.0"
  },
  "build": {
    "appId": "app.toolmoa.pmcanvas",
    "productName": "PM Canvas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.mjs",
      "dialogs.mjs",
      "updates.mjs",
      "store-updates.mjs",
      "preferences.mjs",
      "update-manager.mjs",
      "update-download.mjs",
      "update-signatures.mjs",
      "update-trust.mjs",
      "update-cache.mjs",
      "preload.cjs",
      "document.mjs",
      "assets.mjs",
      "reports.mjs",
      "file-io.mjs",
      "mac-file-access.mjs",
      "excel-worker.mjs",
      "excel-jobs.mjs",
      "excel-session.mjs",
      "app/index.html",
      "app/renderer.js",
      "app/dialog-ui.js",
      "app/holiday-picker.js",
      "app/update-ui.js",
      "app/excel-ui.js",
      "app/planning-ui.js",
      "app/bulk-ui.js",
      "app/desktop.css",
      "app/icon.png",
      "app/shared/engine.js",
      "app/shared/task-model.js",
      "app/shared/management.js",
      "app/shared/management-ui.js",
      "app/shared/project-navigation.js",
      "app/shared/business-clock.js",
      "app/shared/planning.js",
      "app/shared/html.js",
      "app/shared/id.js",
      "app/shared/i18n.js",
      "app/shared/locales/en.js",
      "app/shared/view-ui.js",
      "app/shared/people-view.js",
      "app/shared/project-editor.js",
      "app/shared/reports.js",
      "app/shared/wbs-model.js",
      "app/shared/excel-import-model.js",
      "app/shared/dashboard-view.js",
      "app/shared/local-workspace-view.js",
      "app/shared/holiday-picker.js",
      "app/shared/project-parent-field.js",
      "app/shared/project-visuals.css",
      "app/shared/styles.css",
      "app/model/project.mjs",
      "app/model/errors.mjs",
      "app/node/excel.mjs",
      "app/node/excel-import.mjs",
      "package.json",
      "app/shared/report-clock.js",
      "app/shared/locales/desktop-en.js",
      "app/build-info.json",
      "workspace.mjs",
      "app/shared/korean-holidays.js",
      "app/shared/korean-holidays-data.js",
      "holiday-sync.mjs",
      "app/holiday-ui.js",
      "app/navigation.js",
      "windows-profile.mjs"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": "dir",
      "artifactName": "PMCanvas-Desktop-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "guid": "df0635bf-66e1-510a-b0e5-9ed63f670162"
    },
    "mac": {
      "icon": "build/icon-mac.png",
      "appId": "app.toolmoa.pmcanvas",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "artifactName": "PMCanvas-Desktop-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true
    },
    "electronDownload": {
      "checksums": {
        "electron-v45.1.0-win32-x64.zip": "55eaba17abff7b5bba6c3bbc85068967379024fe742fe9c7fdba9118922ccbe2",
        "electron-v45.1.0-win32-arm64.zip": "c0adce10031826896060bba848777bf9f059bfe4a2f7f9d4795008498eeeb248",
        "electron-v45.1.0-darwin-x64.zip": "b4667d820149e33a6f016d103de0fcf5d6f05b8297a204232a0d970c00b163a5",
        "electron-v45.1.0-darwin-arm64.zip": "002b71efcf90e247317d3da486f2d4e51860e9c2889d49f33e229ab2268b0f3b",
        "electron-v45.1.0-mas-x64.zip": "4608fb25a1b0dd20e5291a611dff73d113123aa547d0c3ba4ddc407517cd40e5",
        "electron-v45.1.0-mas-arm64.zip": "d7d7872db44cbb301596ab26860746e02f5cbc1db7b4abfaed297184bbf3a954"
      }
    }
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "exceljs": "4.4.0",
    "yauzl": "3.4.0"
  },
  "overrides": {
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "glob@>=9.0.0": "14.0.3",
    "minimatch": "11.0.3",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "brand": "Toolmoa"
}
